<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vins_config_file" default="/home/nvidia/vins_ws/src/VINS-Fusion-ROS2-humble-arm/config/d435i_ir_stereo_imu_no_emitter/d435i_stereo_imu_config.yaml"/>
  <arg name="rviz_config_file" default="/home/nvidia/vins_ws/src/VINS-Fusion-ROS2-humble-arm/config/vins_rviz_config.rviz"/>
  <arg name="start_camera" default="false"/>
  <arg name="rviz" default="true"/>

  <include if="$(var start_camera)" file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_namespace" value="camera"/>
    <arg name="camera_name" value="camera"/>
    <arg name="enable_color" value="false"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_infra1" value="true"/>
    <arg name="enable_infra2" value="true"/>
    <arg name="depth_module.infra_profile" value="424x240x30"/>
    <arg name="enable_gyro" value="true"/>
    <arg name="enable_accel" value="true"/>
    <arg name="gyro_fps" value="200"/>
    <arg name="accel_fps" value="200"/>
    <arg name="unite_imu_method" value="2"/>
    <arg name="enable_sync" value="true"/>
  </include>

  <node pkg="vins" exec="vins_node" name="vins_estimator" output="screen" args="$(var vins_config_file)"/>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config_file)"/>
</launch>
